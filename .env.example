# Copy to .env and customize values before running `docker compose up` if desired
MONGODB_URL=mongodb://mongo:27017/anypost
# A secure JWT secret must be at least 32 bytes (>=256 bits). Example below is a 64-hex char (32-byte) value.
JWT_SECRET=b9f6c3a6d3e04f7692a0b1c8d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4
RESEND_API_KEY=change-me
NEXT_PUBLIC_BACKEND_URL=http://server:8080
# Auth cookie Secure flag: empty = auto-detect from request protocol, or true/false
COOKIE_SECURE=
# Extra origins allowed to call the API directly (requests through nginx do not need this)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# Public base URL for form endpoints in integration snippets, e.g. anypost.com or http://1.2.3.4:8080
# Leave empty to use the address the dashboard is opened at
HOSTNAME=
